  <!-- Launchpad Engine & Funnel Wiring -->
  <script src="launch.js?v=16" defer></script>

  <!-- Dynamic Addon Calculation & Interaction Scripts -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // 1. Reveal-up Animations with IntersectionObserver
      var reveals = document.querySelectorAll('.reveal-up');
      if ('IntersectionObserver' in window) {
        var revealObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.remove('reveal-pending');
              revealObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

        reveals.forEach(function (el) {
          var rect = el.getBoundingClientRect();
          if (rect.top > window.innerHeight) {
            el.classList.add('reveal-pending');
          }
          revealObserver.observe(el);
        });
      }

      // 2. Interactive Add-on & Price Calculator
      var addonClients = document.getElementById('addon-agency-clients');
      var addonCredits = document.getElementById('addon-agency-credits');
      var totalDisplay = document.getElementById('agency-total-display');
      var btnPrice = document.getElementById('agency-btn-price');
      var totalNote = document.getElementById('agency-total-note');
      var breakdownClients = document.getElementById('breakdown-clients');
      var breakdownCredits = document.getElementById('breakdown-credits');

      function calculateTotal() {
        var base = 347;
        var clientsChecked = addonClients && addonClients.checked;
        var creditsChecked = addonCredits && addonCredits.checked;

        var total = base;
        if (clientsChecked) total += 67;
        if (creditsChecked) total += 67;

        var formatted = '$' + total;
        if (totalDisplay) totalDisplay.textContent = formatted;
        if (btnPrice) btnPrice.textContent = formatted;
        if (totalNote) totalNote.textContent = formatted;

        if (breakdownClients) {
          breakdownClients.classList.toggle('hidden', !clientsChecked);
        }
        if (breakdownCredits) {
          breakdownCredits.classList.toggle('hidden', !creditsChecked);
        }
      }

      if (addonClients) addonClients.addEventListener('change', calculateTotal);
      if (addonCredits) addonCredits.addEventListener('change', calculateTotal);
      calculateTotal();

      // 3. Mobile Sticky CTA Bar Scroll Trigger
      var mobileBar = document.getElementById('mobile-sticky-cta');
      if (mobileBar) {
        window.addEventListener('scroll', function () {
          if (window.scrollY > 400) {
            mobileBar.classList.remove('translate-y-full');
          } else {
            mobileBar.classList.add('translate-y-full');
          }
        }, { passive: true });
      }

      // 4. Hero Parallax / Mouse Glow Follower
      var heroGlow = document.getElementById('hero-glow');
      if (heroGlow && window.matchMedia('(pointer: fine)').matches) {
        window.addEventListener('mousemove', function (e) {
          var x = (e.clientX / window.innerWidth - 0.5) * 60;
          var y = (e.clientY / window.innerHeight - 0.5) * 40;
          heroGlow.style.transform = 'translate(calc(-50% + ' + x + 'px), ' + y + 'px)';
        }, { passive: true });
      }
    });
  </script>

</body>

</html>
