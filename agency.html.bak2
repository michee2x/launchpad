<!doctype html>
<html lang="en" class="dark" data-theme="dark">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="color-scheme" content="dark light">

  <!-- Immediate Pre-Paint Theme Initialization (1:1 with index, pro & bundle) -->
  <script>
    (function () {
      var saved = null;
      try { saved = localStorage.getItem('wyv-theme') || localStorage.getItem('wyv_theme'); } catch (e) { }
      var system = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      var theme = (saved === 'light' || saved === 'dark') ? saved : system;
      document.documentElement.classList.toggle('dark', theme === 'dark');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>

  <title>WyvStudio Agency Tier — Manage Client Campaigns ($347)</title>
  <meta name="description"
    content="Turn 60-second video creation into a recurring agency. Unlock 3,000 credits, up to 30 client workspaces, unlimited publishing channels, 50 characters, and the client acquisition toolkit for a single $347 investment.">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#ff6b35">

  <!-- Open Graph -->
  <meta property="og:title" content="WyvStudio Agency Tier — Manage Client Campaigns">
  <meta property="og:description"
    content="Unlock 3,000 Credits, 30 Client Workspaces, Unlimited Channels & the Complete Agency Toolkit for $347 one-time.">
  <meta property="og:image" content="https://s3.us-east-005.backblazeb2.com/frame-cast/marketing/launch/agency-clients.jpg">

  <!-- Schema.org Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "name": "WyvStudio",
        "url": "https://special.wyvstudio.com",
        "email": "support@wyvstudio.com"
      },
      {
        "@type": "WebPage",
        "name": "WyvStudio Agency Tier",
        "description": "Commercial client management infrastructure and agency license for WyvStudio."
      },
      {
        "@type": "SoftwareApplication",
        "name": "WyvStudio Agency Tier",
        "applicationCategory": "MultimediaApplication",
        "offers": {
          "@type": "Offer",
          "price": "347",
          "priceCurrency": "USD"
        }
      }
    ]
  }
  </script>

  <!-- Google Fonts: Plus Jakarta Sans, Fraunces & IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500;1,9..144,600;1,9..144,700&family=IBM+Plex+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">

  <!-- Tailwind Play CDN with Rocket.new tokens configuration -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            background: 'var(--background)',
            foreground: 'var(--foreground)',
            card: {
              DEFAULT: 'var(--card)',
              foreground: 'var(--card-foreground)',
            },
            primary: {
              DEFAULT: 'var(--primary)',
              foreground: 'var(--primary-foreground)',
            },
            secondary: {
              DEFAULT: 'var(--secondary)',
              foreground: 'var(--secondary-foreground)',
            },
            accent: {
              DEFAULT: 'var(--accent)',
              foreground: 'var(--accent-foreground)',
            },
            muted: {
              DEFAULT: 'var(--muted)',
              foreground: 'var(--muted-foreground)',
            },
            border: 'var(--border)',
            input: 'var(--input)',
            ring: 'var(--ring)',
            success: {
              DEFAULT: 'var(--success)',
              foreground: 'var(--success-foreground)',
            },
            warning: {
              DEFAULT: 'var(--warning)',
              foreground: 'var(--warning-foreground)',
            },
            destructive: {
              DEFAULT: 'var(--destructive)',
              foreground: 'var(--destructive-foreground)',
            },
          },
          borderRadius: {
            DEFAULT: 'var(--radius)',
          },
          fontFamily: {
            sans: ['var(--font-plus-jakarta-sans)', 'sans-serif'],
            serif: ['var(--font-fraunces)', 'serif'],
            mono: ['var(--font-ibm-plex-mono)', 'monospace'],
          },
        },
      },
    };
  </script>

  <!-- Custom Stylesheet (Rocket Design Tokens, Blobs, Clamps & Sheens) -->
  <link rel="stylesheet" href="rocket-agency-styles.css?v=1">
</head>

<body class="bg-background text-foreground selection:bg-primary/20 selection:text-primary">

  <!-- ========================================================
       TOP STATUS RIBBON (Pulsing Urgent Warning Banner)
       ======================================================== -->
  <div id="status-ribbon"
    class="sticky top-0 z-50 border-b border-amber-500/30 bg-amber-500/10 px-4 py-2.5 text-center backdrop-blur-md transition-colors">
    <div class="mx-auto flex max-w-7xl items-center justify-center gap-2.5 text-xs sm:text-sm font-black uppercase tracking-wider text-amber-500 dark:text-amber-400">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-amber-500"></span>
      </span>
      <span>ORDER STATUS: FINAL STEP — DO NOT CLOSE OR REFRESH THIS PAGE</span>
    </div>
  </div>

  <!-- ========================================================
       HEADER / NAV
       ======================================================== -->
  <header id="site-header" class="relative z-40 border-b border-border/40 bg-background/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6">
      <a href="#top" class="flex items-center gap-3" aria-label="WyvStudio home">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary shadow-sm shadow-primary/30">
          <svg viewBox="0 0 64 64" class="h-6 w-6 text-primary-foreground" aria-hidden="true">
            <path d="M14 18 L22 46 L32 28 L42 46 L50 18" stroke="currentColor" stroke-width="6" stroke-linecap="round"
              stroke-linejoin="round" fill="none" />
          </svg>
        </span>
        <span class="text-lg font-black tracking-tight text-foreground">WyvStudio</span>
      </a>

      <div class="flex items-center gap-3">
        <span
          class="hidden rounded-full border border-border bg-card/70 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground backdrop-blur sm:inline-flex">
          Upgrade 3 · Final Step · Agency License
        </span>

        <!-- Theme Toggle Button -->
        <button type="button" id="theme-toggle" aria-label="Switch theme"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border bg-card/70 text-muted-foreground backdrop-blur hover:bg-secondary hover:text-foreground transition-colors">
          <!-- Sun icon (shown in dark mode) -->
          <svg id="theme-icon-sun" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg id="theme-icon-moon" class="h-4 w-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main id="top" class="relative bg-background text-foreground">

    <!-- ========================================================
         URGENCY ATTENTION BANNER
         ======================================================== -->
    <section class="border-b border-border/50 bg-secondary/50 py-3.5 px-4 sm:px-6">
      <div class="mx-auto flex max-w-5xl items-start sm:items-center gap-3">
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-primary/20 text-primary mt-0.5 sm:mt-0">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </span>
        <p class="text-xs sm:text-sm font-medium leading-relaxed text-muted-foreground">
          <strong class="font-bold text-foreground">ATTENTION:</strong> Your account is being finalized right now. Before you enter your dashboard, we have one final, private invitation reserved for marketing agencies, consultants, video service providers, and power users looking to monetise video creation as a service.
        </p>
      </div>
    </section>

    <!-- ========================================================
         1. HERO SECTION (Refit-Style 2-Column High-Converting Layout)
         ======================================================== -->
    <section class="relative overflow-hidden bg-background pb-16 pt-12 sm:pt-16 md:pb-24">
      <!-- Ambient Atmosphere & Depth Layers -->
      <div class="bg-grid-lines mask-grid-fade pointer-events-none absolute inset-0 z-0 opacity-40" aria-hidden="true"></div>
      <div class="blob-primary float-slow pointer-events-none absolute -left-20 top-12 h-[380px] w-[380px] rounded-full opacity-35" aria-hidden="true"></div>
      <div class="blob-accent float-slow pointer-events-none absolute -right-20 top-44 h-[340px] w-[340px] rounded-full opacity-25" aria-hidden="true"></div>
      <div id="hero-glow" class="pointer-events-none absolute left-1/2 top-20 h-[380px] w-[380px] -translate-x-1/2 rounded-full bg-primary/15 blur-[100px] transition-transform duration-300 ease-out" aria-hidden="true"></div>
      <div class="grain pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>

      <div class="relative z-10 mx-auto max-w-[1360px] px-4 sm:px-6 md:px-8 lg:px-12">
        <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-10 xl:gap-14">

          <!-- Left Column: Eyebrow, Headline, Body, Mini Stats Strip, Refit CTA & Trust -->
          <div class="lg:col-span-6 flex flex-col justify-center">
            <!-- Eyebrow Status Pill -->
            <div class="reveal-up mb-4">
              <span class="inline-flex items-center gap-2 rounded-full border border-border/80 bg-card/70 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground backdrop-blur-md">
                <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
                WyvStudio Agency Tier · Manage Client Campaigns
              </span>
            </div>

            <!-- Headline -->
            <h1 class="reveal-up text-3xl sm:text-4xl lg:text-[42px] font-extrabold tracking-tight leading-[1.15] text-foreground" style="transition-delay: 80ms;">
              Want to Turn 60-Second Video Creation Into a <span class="italic font-serif text-primary">$5,000 to $10,000/Month</span> Recurring Agency?
            </h1>

            <!-- Subheadline / Lede -->
            <p class="reveal-up mt-4 text-base sm:text-lg font-bold leading-snug text-foreground/90" style="transition-delay: 140ms;">
              Deliver High-Converting Video Ads &amp; Daily Shorts to Paying Clients Without Doing the Manual Editing Work.
            </p>

            <!-- Offer Details Body -->
            <p class="reveal-up mt-3 text-sm sm:text-base font-normal leading-relaxed text-muted-foreground" style="transition-delay: 180ms;">
              Unlock the WyvStudio Agency License: 3,000 Credits, Up to 30 Client Workspaces, Unlimited Publishing Channels, 50 Characters, Up to 100 Cloned Voices, and Our Complete Client-Getting Toolkit for a Single One-Time Investment of Just $347.
            </p>

            <!-- Mini Stats Strip (Offer Snapshot) -->
            <div class="reveal-up my-6 grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3" style="transition-delay: 220ms;">
              <div class="rounded-xl border border-border/70 bg-card/60 p-3 backdrop-blur-sm">
                <span class="block font-mono-label text-xl font-black text-foreground">$347</span>
                <span class="block text-[11px] font-semibold text-muted-foreground uppercase tracking-wide">One-Time Fee</span>
              </div>
              <div class="rounded-xl border border-border/70 bg-card/60 p-3 backdrop-blur-sm">
                <span class="block font-mono-label text-xl font-black text-primary">3,000</span>
                <span class="block text-[11px] font-semibold text-muted-foreground uppercase tracking-wide">Agency Credits</span>
              </div>
              <div class="rounded-xl border border-border/70 bg-card/60 p-3 backdrop-blur-sm">
                <span class="block font-mono-label text-xl font-black text-foreground">30</span>
                <span class="block text-[11px] font-semibold text-muted-foreground uppercase tracking-wide">Workspaces</span>
              </div>
              <div class="rounded-xl border border-border/70 bg-card/60 p-3 backdrop-blur-sm">
                <span class="block font-mono-label text-xl font-black text-foreground">100</span>
                <span class="block text-[11px] font-semibold text-muted-foreground uppercase tracking-wide">Cloned Voices</span>
              </div>
            </div>

            <!-- Refit-Style Primary CTA Pill -->
            <div class="reveal-up flex flex-col items-start gap-3" style="transition-delay: 260ms;">
              <a href="#finish" data-buy="agency"
                class="lp-buy brand-cta-btn group relative inline-flex min-h-[56px] w-full items-center justify-center gap-3 rounded-full px-6 py-4 text-center shadow-2xl transition-all duration-300 hover:scale-[1.02] sm:w-auto sm:px-8 sm:py-4.5">
                <span class="text-sm sm:text-base font-black tracking-tight text-white leading-snug">
                  YES! UPGRADE TO THE AGENCY TIER FOR JUST $347
                </span>
                <span class="text-base sm:text-xl font-black text-white transition-transform duration-300 group-hover:translate-x-1 shrink-0">→</span>
              </a>

              <p class="font-mono-label text-xs font-semibold text-muted-foreground tracking-wide">
                ⚡ 1-Click Instant Charge to Card on File — Lifetime Agency License, No Monthly Seat Fees
              </p>
            </div>

            <!-- Trust Badges & Guarantee Micro-Strip -->
            <div class="reveal-up mt-6 flex flex-wrap items-center gap-4 border-t border-border/50 pt-5 text-xs text-muted-foreground" style="transition-delay: 300ms;">
              <div class="flex items-center gap-1.5 font-medium">
                <svg class="h-4 w-4 text-emerald-500" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span>14-Day 100% Money-Back Guarantee</span>
              </div>
              <div class="flex items-center gap-1.5 font-medium">
                <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span>256-Bit SSL Encrypted</span>
              </div>
              <div class="flex items-center gap-1.5 font-medium">
                <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
                <span>Instant Account Provisioning</span>
              </div>
            </div>

          </div>

          <!-- Right Column: Interactive Agency Workspace Showcase Card -->
          <div class="lg:col-span-6">
            <div class="reveal-up relative mx-auto max-w-lg lg:max-w-none" style="transition-delay: 200ms;">
              <!-- Atmospheric Underglow -->
              <div class="absolute -inset-1.5 rounded-3xl bg-gradient-to-r from-primary/30 to-accent/30 opacity-50 blur-xl"></div>

              <div class="relative overflow-hidden rounded-2xl border border-border/80 bg-card p-2 sm:p-3 shadow-2xl">
                <!-- Browser Chrome Mockup Header -->
                <div class="flex items-center justify-between border-b border-border/60 bg-secondary/60 px-4 py-2.5 rounded-t-xl">
                  <div class="flex items-center gap-1.5">
                    <span class="h-3 w-3 rounded-full bg-rose-500/80"></span>
                    <span class="h-3 w-3 rounded-full bg-amber-500/80"></span>
                    <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
                    <span class="ml-2 font-mono-label text-[11px] font-medium text-muted-foreground">wyvstudio.com/agency/workspaces</span>
                  </div>
                  <span class="rounded-full bg-primary/10 px-2.5 py-0.5 font-mono-label text-[10px] font-bold text-primary">
                    30 / 30 SLOTS ACTIVE
                  </span>
                </div>

                <!-- Genuine Agency Screenshot Showcase -->
                <div class="relative aspect-[16/10] overflow-hidden rounded-b-xl bg-muted">
                  <img
                    src="https://s3.us-east-005.backblazeb2.com/frame-cast/marketing/launch/agency-clients.jpg"
                    alt="WyvStudio agency dashboard showing dedicated client workspaces with isolated brand kits and video production queues"
                    loading="eager"
                    class="h-full w-full object-cover transition-transform duration-700 hover:scale-105" />
                  <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-transparent to-transparent"></div>

                  <!-- Floating Glass Widget 1: Client Retainer Callout -->
                  <div class="absolute bottom-4 left-4 right-4 sm:right-auto sm:max-w-sm rounded-xl border border-border/80 bg-card/90 p-3.5 shadow-xl backdrop-blur-md">
                    <div class="flex items-center gap-3">
                      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-500/20 text-emerald-500 font-black text-sm">
                        $1.2K
                      </div>
                      <div>
                        <div class="flex items-center gap-2">
                          <span class="text-xs font-bold text-foreground">Client: Apex DTC Brand</span>
                          <span class="rounded bg-emerald-500/20 px-1.5 py-0.5 text-[10px] font-bold text-emerald-400">Paid Retainer</span>
                        </div>
                        <p class="text-[11px] text-muted-foreground">12 video ads generated &amp; scheduled in 45 minutes</p>
                      </div>
                    </div>
                  </div>

                  <!-- Floating Glass Badge 2: Top Right Status -->
                  <div class="absolute top-4 right-4 rounded-lg border border-border/70 bg-card/85 px-3 py-1.5 shadow-lg backdrop-blur-md hidden sm:flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-primary animate-ping"></span>
                    <span class="font-mono-label text-xs font-bold text-foreground">Priority Render Queue: VIP</span>
                  </div>
                </div>

                <!-- Agency Metrics Footer Strip -->
                <div class="mt-3 grid grid-cols-3 gap-2 px-2 py-1 text-center">
                  <div class="rounded-lg bg-secondary/50 p-2">
                    <span class="block text-xs font-bold text-foreground">30 Workspaces</span>
                    <span class="block text-[10px] text-muted-foreground">Isolated Brands</span>
                  </div>
                  <div class="rounded-lg bg-secondary/50 p-2">
                    <span class="block text-xs font-bold text-foreground">Unlimited</span>
                    <span class="block text-[10px] text-muted-foreground">Publishing Profiles</span>
                  </div>
                  <div class="rounded-lg bg-secondary/50 p-2">
                    <span class="block text-xs font-bold text-foreground">Commercial</span>
                    <span class="block text-[10px] text-muted-foreground">White-Label Rights</span>
                  </div>
                </div>

              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ========================================================
         2. THE MARKET OPPORTUNITY SECTION
         ======================================================== -->
    <section class="relative border-t border-border/40 bg-secondary/30 py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 md:px-8">

        <div class="reveal-up mx-auto max-w-3xl text-center">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-border/80 bg-card/60 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-primary backdrop-blur-sm">
            High-Margin Commercial Opportunity
          </span>
          <h2 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
            The Biggest Market Opportunity in Digital Marketing Right Now
          </h2>
          <p class="mt-4 text-base sm:text-lg text-muted-foreground leading-relaxed">
            Look at the businesses in your local area and across social media. Every single one of them is starving for consistent video content:
          </p>
        </div>

        <!-- 4 Target Niche Cards Grid -->
        <div class="reveal-up mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" style="transition-delay: 100ms;">

          <!-- Card 1: E-commerce -->
          <div class="group relative flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-xl">
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary mb-4 transition-transform group-hover:scale-110">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-foreground">E-Commerce Brands</h3>
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                Needing 10+ Meta and TikTok video ads every single week to test creative hooks and beat ad fatigue.
              </p>
            </div>
            <div class="mt-6 border-t border-border/50 pt-4 flex items-center justify-between">
              <span class="text-xs font-semibold text-muted-foreground">Typical Retainer</span>
              <span class="font-mono-label text-sm font-bold text-primary">$1,500 – $3,000/mo</span>
            </div>
          </div>

          <!-- Card 2: Real Estate -->
          <div class="group relative flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-xl">
            <div>
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary mb-4 transition-transform group-hover:scale-110">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-foreground">Real Estate Agents</h3>
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                Wanting vertical property walk-throughs, agent intros, and neighborhood reels without holding cameras.
              </p>
            </div>
            <div class="mt-6 border-t border-border/50 pt-4 flex items-center justify-between">
              <span class="text-xs font-semibold text-muted-foreground">Typical Retainer</span>
              <span class="font-mono-label text-sm font-bold text-primary">$1,200 – $2,500/mo</span>
            </div>
          </div>

          <!-- Card 3: Local Services -->
          <div class="group relative flex flex-col justify-between rounded-2xl border border-border/80 bg-card p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-xl">
